# CoreHealth backend — environment variables
# All of these are injected by CDK at deploy time. This file documents what each var is.
# For local scripts/tooling, copy to .env and fill in values from AWS console.

# ─── Database ─────────────────────────────────────────────────────────────────
# RDS Postgres endpoint (from database-stack output)
DB_ENDPOINT=corehealth-database-xxxx.xxxx.eu-north-1.rds.amazonaws.com

# Secrets Manager ARN containing { username, password, dbname, port }
DB_SECRET_ARN=arn:aws:secretsmanager:eu-north-1:xxxx:secret:corehealth/db/credentials-xxxx

# ─── Storage ──────────────────────────────────────────────────────────────────
# S3 bucket name for lab result PDFs and user uploads
DOCUMENTS_BUCKET=corehealth-documents-xxxx

# SQS queue URL for async document processing (lab-results → OCR → biomarkers)
DOCUMENT_QUEUE_URL=https://sqs.eu-north-1.amazonaws.com/xxxx/corehealth-document-processing

# ─── API secrets (stored in Secrets Manager, ARNs passed as env vars) ─────────
# OpenAI API key (used by ai-agent and trend-analyzer lambdas)
OPENAI_SECRET_ARN=arn:aws:secretsmanager:eu-north-1:xxxx:secret:corehealth/openai/api-key

# Google Cloud Vision API key (used by lab-results and document-processor lambdas)
GOOGLE_VISION_SECRET_ARN=arn:aws:secretsmanager:eu-north-1:xxxx:secret:corehealth/google/vision-api-key

# Whoop OAuth credentials { client_id, client_secret }
WHOOP_SECRET_ARN=arn:aws:secretsmanager:eu-north-1:xxxx:secret:corehealth/whoop/oauth

# Oura OAuth credentials { client_id, client_secret }
OURA_SECRET_ARN=arn:aws:secretsmanager:eu-north-1:xxxx:secret:corehealth/oura/oauth

# ─── OAuth ────────────────────────────────────────────────────────────────────
# Deep-link redirect URI used after device OAuth flow completes
OAUTH_REDIRECT_URI=corehealth://oauth

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production

# ─── AWS (for local CDK / AWS CLI usage) ──────────────────────────────────────
AWS_REGION=eu-north-1
AWS_ACCOUNT=943273444181
