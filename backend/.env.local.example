# CoreHealth local dev environment
# Copy to .env.local, then: source .env.local (or use dotenv-cli / direnv)
#
# Prerequisites:
#   docker compose up -d     — start local Postgres
#   npm run local:migrate    — run all migrations against local DB
#   npm run local:seed       — insert test user + realistic data

LOCAL_DEV=true
DATABASE_URL=postgres://corehealth_admin:localdev@localhost:5432/corehealth

# AWS region still needed for any scripts that touch AWS (e.g. CDK diff)
AWS_REGION=eu-north-1
AWS_ACCOUNT=943273444181
