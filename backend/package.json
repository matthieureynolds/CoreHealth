{
  "name": "backend",
  "version": "0.1.0",
  "bin": {
    "backend": "bin/backend.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "seed": "ts-node -r dotenv/config scripts/seed.ts",
    "seed:reset": "ts-node -r dotenv/config scripts/seed.ts -- --reset",
    "local:migrate": "DOTENV_CONFIG_PATH=.env.local ts-node -r dotenv/config scripts/local-migrate.ts",
    "local:seed": "DOTENV_CONFIG_PATH=.env.local ts-node -r dotenv/config scripts/seed.ts",
    "local:seed:reset": "DOTENV_CONFIG_PATH=.env.local ts-node -r dotenv/config scripts/seed.ts -- --reset"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "aws-cdk": "2.1116.0",
    "esbuild": "^0.27.5",
    "jest": "^30",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-comprehendmedical": "^3.1022.0",
    "@aws-sdk/client-s3": "^3.1022.0",
    "@aws-sdk/client-secrets-manager": "^3.1022.0",
    "@aws-sdk/client-sqs": "^3.1022.0",
    "@aws-sdk/client-textract": "^3.1022.0",
    "@aws-sdk/s3-request-presigner": "^3.1022.0",
    "@types/pdf-parse": "^1.1.5",
    "aws-cdk-lib": "^2.246.0",
    "constructs": "^10.6.0",
    "dotenv": "^16.6.1",
    "openai": "^6.33.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0"
  }
}
