#!/bin/sh
# Runs from the repo root (~/TOTO); the app lives in app/.
# Only staged TS/TSX under app/src is checked, so the hook stays fast enough
# to actually leave enabled.

STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^app/src/.*\.tsx?$' || true)
[ -z "$STAGED" ] && exit 0

cd app || exit 1

# Tools expect paths relative to app/.
REL=$(echo "$STAGED" | sed 's|^app/||')

# Formatting is enforced everywhere: the whole repo already passes.
echo "▸ prettier --check"
# shellcheck disable=SC2086
if ! npx prettier --check $REL; then
  echo "  ✗ formatting issues — run: cd app && npx prettier --write $REL"
  exit 1
fi

# Linting is a ratchet, not a wall. The travel domain is at zero errors, so
# regressions there are blocked. The rest of the app still carries ~124
# pre-existing unused-var errors; failing on those would block every commit
# and the hook would just get disabled. Widen CLEAN_PATHS as areas are fixed.
CLEAN_PATHS='^(features/travel/|shared/services/travel/|shared/services/http|shared/utils/logger)'
CLEAN=$(echo "$REL" | grep -E "$CLEAN_PATHS" || true)

if [ -n "$CLEAN" ]; then
  # --max-warnings 0: the travel domain is at zero warnings as well as zero
  # errors, so a new warning there is a regression like any other. The rest of
  # the app still carries hundreds, which is why this is scoped.
  echo "▸ eslint (enforced, zero-warning — already-clean areas)"
  # shellcheck disable=SC2086
  if ! npx eslint --max-warnings 0 $CLEAN; then
    echo "  ✗ lint problems in an area that was clean — fix, then stage the correction."
    exit 1
  fi
fi

OTHER=$(echo "$REL" | grep -vE "$CLEAN_PATHS" || true)
if [ -n "$OTHER" ]; then
  echo "▸ eslint (advisory — legacy areas, not blocking)"
  # shellcheck disable=SC2086
  npx eslint $OTHER || true
fi

# Whole-graph checks. Only run when the travel domain is actually touched:
# both walk every file, so gating them keeps commits elsewhere fast.
TRAVEL=$(echo "$REL" | grep -E '^(features/travel/|shared/services/travel/)' || true)

if [ -n "$TRAVEL" ]; then
  # ESLint cannot see a dead *export* — it counts `export` as a use, which is
  # how 18 unused service functions accumulated. knip resolves the import graph.
  echo "▸ knip (dead exports/files — travel)"
  if ! node scripts/knip-travel.js; then
    exit 1
  fi

  # Copy-paste detector. Travel previously carried the same metric copy in
  # three files and two whole implementations of the same screen.
  echo "▸ jscpd (duplication — travel)"
  if ! npx jscpd --config .jscpd.json --silent; then
    echo "  ✗ duplicated block introduced — extract the shared part."
    exit 1
  fi

  # Architecture: no cycles inside travel, no deep imports across a feature
  # boundary, no shared/ module reaching into travel.
  echo "▸ depcruise (architecture — travel)"
  if ! npx depcruise src --config .dependency-cruiser.js; then
    echo "  ✗ import-boundary violation — go through the feature's index.ts."
    exit 1
  fi
fi

exit 0
